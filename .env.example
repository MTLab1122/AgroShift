# AgroShift Environment Configuration Template
# NASA Space Apps Challenge 2026: Adapting Farms with NASA Data
# Copy this file to .env:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)

# ==============================================================================
# Server Configuration
# ==============================================================================
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DEBUG=True

# Allowed origins for CORS (comma-separated, typically Next.js frontend on 3000)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ==============================================================================
# Database Configuration (Module 01: Farm Management & Location Intelligence)
# ==============================================================================
# Default uses the local SQLite file in data/agroshift.db.
# For production PostgreSQL:
# DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/agroshift_db
DATABASE_URL=sqlite:///./data/agroshift.db

# ==============================================================================
# NASA Space Apps 2026: Primary Live Data Source (NASA POWER Daily API)
# ==============================================================================
# Public Agroclimatology (AG) single point temporal daily API (NO API key required)
NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# HTTP Request Timeout (seconds)
NASA_POWER_TIMEOUT_SECONDS=20.0

# Retry attempts for transient 429/5xx errors
NASA_POWER_MAX_RETRIES=3

# In-memory Cache TTL (seconds, default: 3600 = 1 hour)
NASA_POWER_CACHE_TTL_SECONDS=3600

# Optional: Default to demo fixture if true
NASA_DEFAULT_DEMO_MODE=false

# ==============================================================================
# NASA Space Apps 2026: Secondary Earth Observation Hooks (Optional)
# ==============================================================================
# NASA Earthdata Login Token (Optional Bearer token for SMAP & GPM direct access)
# Get a free token at https://urs.earthdata.nasa.gov
NASA_EARTHDATA_TOKEN=

# NASA SMAP L4 Soil Moisture CMR Granule Search Endpoint (~9 km resolution)
NASA_SMAP_ENDPOINT=https://cmr.earthdata.nasa.gov/search/granules.json?short_name=SPL4SMGP

# NASA GPM IMERG Daily Calibrated Precipitation Endpoint (~10 km resolution)
NASA_GPM_ENDPOINT=https://gpm1.gesdisc.eosdis.nasa.gov/data/GPM_L3/GPM_3IMERGDF.07
